#!/usr/bin/env bash

case $1 in
    home)
        exec foot
        ;;
    cwd)
        pid=$(swaymsg -t get_tree | jq -r '.. | objects | select(.focused == true) | .pid // empty')

        if [ -n "$pid" ]; then
            child_pid=$(pgrep -P $pid | tail -n 1)
            target_pid=${child_pid:-$pid}
            cwd=$(readlink -f /proc/$target_pid/cwd)
            exec foot --working-directory $cwd
        else
            exec foot
        fi
        ;;
esac
