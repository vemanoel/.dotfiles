#!/usr/bin/env bash

shopt -s dotglob nullglob expand_aliases

root=$(dirname -- $(realpath -- $0))/root

while IFS=: read -r src dst sudo; do
    for path in $src/*; do
        [[ -e $path || -L $path ]] || continue

        target=$dst/${path##*/}

        $sudo rm -rf -- $target
        $sudo cp -r -- $path $target

        $sudo chmod +x -- $target/**/*.{sh,desktop} 2>/dev/null
    done
done <<EOF
$root/home/user:$HOME:
$root/etc:/etc:sudo
EOF

sudo pacman --noconfirm -Syu --needed \
    ttf-jetbrains-mono \
    sway swaybg jq \
    greetd greetd-tuigreet \
    fuzzel \
    firefox foot nnn btop \
    mako libnotify \
    mpv swayimg \
    pacman-contrib \
    grim slurp \
    helix make git podman podman-compose \
    yt-dlp deno ffmpeg \
    pipewire pipewire-pulse wireplumber \
    xdg-desktop-portal xdg-desktop-portal-gtk xdg-desktop-portal-wlr

sudo systemctl enable greetd.service
sudo systemctl enable paccache.timer

sudo reboot
