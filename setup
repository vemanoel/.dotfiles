#!/usr/bin/env bash

shopt -s dotglob nullglob expand_aliases

root=$(dirname -- $(realpath -- $0))/root

while IFS=: read -r src dst sudo; do
    for path in $src/*; do
        [[ -e $path || -L $path ]] || continue

        target=$dst/${path##*/}

        $sudo rm -rf -- $target
        $sudo cp -- $path $target

        $sudo chmod +x -- $target/**/*.{sh,desktop} 2>/dev/null
    done
done <<EOF
$root/home/user:$HOME:
$root/etc:/etc:sudo
EOF

alias in='sudo pacman --noconfirm -Syu --needed'

in ttf-jetbrains-mono
in sway swaybg jq
in greetd greetd-tuigreet
in fuzzel
in firefox foot nnn btop
in mako libnotify
in mpv swayimg
in pacman-contrib
in grim slurp
in helix make git podman podman-compose
in yt-dlp deno ffmpeg
in pipewire pipewire-pulse wireplumber
in xdg-desktop-portal xdg-desktop-portal-gtk xdg-desktop-portal-wlr

sudo systemctl enable greetd.service
sudo systemctl enable paccache.timer

sudo reboot
