#!/usr/bin/env bash

sudo rm -rf /etc/{firefox,brave,greetd,tuigreet}
sudo mv {firefox,brave,greetd,tuigreet} /etc

mv -f shell/* $HOME

mkdir -p $HOME/.config
rm -rf $HOME/.config/{btop,foot,fuzzel,git,greetd,helix,mako,nnn,sway,yt-dlp}
mv {btop,foot,fuzzel,git,greetd,helix,mako,nnn,sway,yt-dlp} $HOME/.config

sudo pacman --noconfirm -Syu --needed \
    ttf-jetbrains-mono \
    sway swaybg jq \
    greetd greetd-tuigreet \
    fuzzel \
    firefox foot nnn btop \
    mako libnotify \
    mpv swayimg \
    pacman-contrib \
    grim slurp \
    helix make git podman podman-compose \
    yt-dlp deno ffmpeg \
    pipewire pipewire-pulse wireplumber \
    xdg-desktop-portal xdg-desktop-portal-gtk xdg-desktop-portal-wlr

sudo systemctl enable greetd.service paccache.timer

sudo reboot
