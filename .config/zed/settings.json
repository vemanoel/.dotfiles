{
	"disable_ai": true,
	"autosave": "off",
	"base_keymap": "Zed",
	"git": {
		"inline_blame": {
			"enabled": false,
		},
		"git_gutter": "hide",
	},
	"auto_update": true,
	"restore_on_startup": "empty_tab",
	"session": {
		"restore_unsaved_buffers": false,
		"trust_all_worktrees": true,
	},
	"default_open_behavior": "new_window",
	"cli_default_open_behavior": "new_window",
	"on_new_window": "empty_tab",
	"use_system_path_prompts": true,
	"use_system_prompts": true,
	"preview_tabs": {
		"enable_keep_preview_on_code_navigation": false,
		"enable_preview_file_from_code_navigation": false,
		"enable_preview_multibuffer_from_code_navigation": false,
		"enable_preview_from_multibuffer": false,
		"enable_preview_from_project_panel": false,
		"enabled": false,
	},
	"tabs": {
		"show_diagnostics": "all",
		"show_close_button": "always",
		"activate_on_close": "history",
		"close_position": "right",
		"file_icons": false,
		"git_status": true,
	},
	"tab_bar": {
		"show_pinned_tabs_in_separate_row": false,
		"show_tab_bar_buttons": false,
		"show_nav_history_buttons": false,
		"show": true,
	},
	"title_bar": {
		"show_branch_status_icon": false,
		"show_menus": false,
		"show_user_menu": false,
		"show_sign_in": false,
		"show_onboarding_banner": false,
		"show_project_items": false,
		"show_worktree_name": false,
		"show_branch_name": true,
	},
	"diagnostics": {
		"lsp_pull_diagnostics": {
			"debounce_ms": 0,
			"enabled": true,
		},
		"button": true,
	},
	"search": {
		"button": true,
	},
	"status_bar": {
		"show_active_file": false,
		"line_endings_button": false,
		"cursor_position_button": false,
		"active_encoding_button": "disabled",
		"active_language_button": false,
	},
	"debugger": {
		"button": false,
	},
	"outline_panel": {
		"button": false,
	},
	"collaboration_panel": {
		"button": false,
	},
	"terminal": {
		"scrollbar": {
			"show": "auto",
		},
		"toolbar": {
			"breadcrumbs": false,
		},
		"default_height": 320.0,
		"default_width": 600.0,
		"open_links_in_mouse_mode": false,
		"keep_selection_on_copy": true,
		"copy_on_select": false,
		"minimum_contrast": 80.0,
		"blinking": "terminal_controlled",
		"cursor_shape": "bar",
		"font_weight": 400.0,
		"font_size": 14.0,
		"working_directory": "current_project_directory",
		"shell": "system",
		"button": true,
		"dock": "right",
	},
	"project_panel": {
		"button": true,
		"auto_open": {
			"on_drop": false,
			"on_create": false,
			"on_paste": false,
		},
		"sort_mode": "directories_first",
		"hide_hidden": false,
		"hide_root": true,
		"indent_size": 14.0,
		"drag_and_drop": false,
		"indent_guides": {
			"show": "never",
		},
		"git_status_indicator": true,
		"diagnostic_badges": true,
		"show_diagnostics": "all",
		"scrollbar": {
			"show": "auto",
		},
		"bold_folder_labels": false,
		"auto_fold_dirs": false,
		"starts_open": true,
		"auto_reveal_entries": true,
		"folder_indicator": "chevron",
		"file_icons": true,
		"entry_spacing": "standard",
		"hide_gitignore": false,
		"default_width": 250.0,
		"dock": "left",
	},
	"extend_comment_on_newline": false,
	"middle_click_paste": false,
	"code_lens": "off",
	"inlay_hints": {
		"enabled": false,
	},
	"completions": {
		"lsp_insert_mode": "replace",
		"lsp_fetch_timeout_ms": 0,
		"lsp": true,
		"words": "disabled",
	},
	"show_completion_documentation": true,
	"show_completions_on_input": false,
	"show_whitespaces": "none",
	"jsx_tag_auto_close": {
		"enabled": true,
	},
	"use_auto_surround": false,
	"use_autoclose": false,
	"line_ending": "detect",
	"ensure_final_newline_on_save": false,
	"remove_trailing_whitespace_on_save": false,
	"format_on_save": "on",
	"indent_guides": {
		"enabled": false,
	},
	"preferred_line_length": 80,
	"show_wrap_guides": false,
	"soft_wrap": "none",
	"auto_indent_on_paste": false,
	"hard_tabs": true,
	"tab_size": 4,
	"toolbar": {
		"selections_menu": false,
		"quick_actions": false,
		"breadcrumbs": false,
	},
	"minimap": {
		"show": "never",
	},
	"scrollbar": {
		"show": "always",
		"cursors": false,
		"git_diff": false,
		"search_results": false,
		"selected_text": false,
		"selected_symbol": false,
		"axes": {
			"horizontal": true,
			"vertical": true,
		},
		"diagnostics": "all",
	},
	"inline_code_actions": false,
	"gutter": {
		"folds": false,
		"bookmarks": false,
		"breakpoints": false,
		"runnables": false,
		"line_numbers": false,
	},
	"drag_and_drop_selection": {
		"enabled": false,
	},
	"hover_popover_delay": 200,
	"vertical_scroll_margin": 999,
	"horizontal_scroll_margin": 999,
	"scroll_beyond_last_line": "off",
	"markdown_preview": {
		"max_width": 600.0,
		"open_markdown_files_in_preview": true,
		"limit_content_width": true,
		"font_family": "Iosevka Fixed",
		"code_font_family": "Iosevka Fixed",
	},
	"buffer_font_family": "Iosevka Fixed",
	"ui_font_family": "Iosevka Fixed",
	"rounded_selection": false,
	"selection_highlight": false,
	"current_line_highlight": "all",
	"unnecessary_code_fade": 0.4,
	"reduce_motion": "on",
	"hide_mouse": "never",
	"cursor_shape": "bar",
	"cursor_animation": {
		"enabled": false,
	},
	"semantic_tokens": "off",
	"lsp_highlight_debounce": 0,
	"cursor_blink": false,
	"multi_cursor_modifier": "cmd_or_ctrl",
	"buffer_line_height": "standard",
	"icon_theme": "Symbols Icon Theme",
	"ui_font_size": 14.0,
	"buffer_font_size": 14.0,
	"theme": {
		"mode": "dark",
		"light": "One Light",
		"dark": "macOS Classic Dark",
	},
	"theme_overrides": {
		"macOS Classic Dark": {
			"syntax": {
				"comment": {
					"font_style": "normal",
				},
				"comment.doc": {
					"font_style": "normal",
				},
				"keyword": {
					"font_style": "normal",
				},
			},
		},
	},
	"auto_install_extensions": {
		"html": false,
		"symbols": true,
		"macos-classic": true,
	},
	"allow_binary_downloads": true,
}
